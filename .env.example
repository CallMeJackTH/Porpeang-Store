# Copy these into Vercel → Project → Settings → Environment Variables (Production, Preview, Development).
# Redeploy after any change.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API → anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Supabase → Project Settings → API → service_role key. SERVER ONLY: never put it in index.html or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: domain of the internal (never mailed) login addresses. Default: players.porpeang.app
# Changing it after players exist breaks their logins — leave it unset unless you set it from day one.
# PLAYER_EMAIL_DOMAIN=players.porpeang.app
